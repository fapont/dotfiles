fnox.local.toml
.fnox.local.toml
.env
.claude/worktrees/

# colima runtime state (VM disk/store, sockets, tunnel ssh config) --
# lands here only because ~/.config/colima is symlinked into the repo.
modules/docker/home/.config/colima/_lima/
modules/docker/home/.config/colima/_store/
modules/docker/home/.config/colima/default/daemon/
modules/docker/home/.config/colima/ssh_config
modules/docker/home/.config/colima/*.sock
modules/docker/home/.config/colima/default/*.sock

# Machine-local mise config (e.g. modules/doctolib.local.toml, miserc.local.toml)
# loaded through ~/.config/mise.
*.local.toml
