#!/usr/bin/env bash
#MISE description="Restore the fnox age key from Bitwarden"
set -euo pipefail
if [ -f ~/.ssh/id_ed25519_age ]; then
  echo "~/.ssh/id_ed25519_age already present, nothing to restore"
  exit 0
fi
BW_SESSION=$(bw unlock --raw)
mkdir -p ~/.ssh
item=$(bw get item "fnox age" --session "$BW_SESSION")
echo "$item" | jq -r '.sshKey.privateKey' > ~/.ssh/id_ed25519_age
chmod 600 ~/.ssh/id_ed25519_age
echo "$item" | jq -r '.sshKey.publicKey' > ~/.ssh/id_ed25519_age.pub
chmod 644 ~/.ssh/id_ed25519_age.pub
echo "Restored ~/.ssh/id_ed25519_age(.pub)"
