# style
font-size = 14
font-style = medium
bold-is-bright = true
theme = "Catppuccin Macchiato"
font-family = "JetBrainsMono Nerd Font Mono"
background-opacity = 0.9
background-blur = macos-glass-regular
# Read theme colors as Display P3: more vivid than the default sRGB.
window-colorspace = display-p3
window-decoration = true

# cursor
cursor-style = block
cursor-style-blink = false

# clipboard
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

# mouse
mouse-scroll-multiplier = 2
mouse-hide-while-typing = true

# behavior
auto-update = check
auto-update-channel = stable
quit-after-last-window-closed = true
shell-integration-features = true

# macos
macos-titlebar-style = transparent
macos-icon = xray

# Keybinding
# keybind = global:cmd+:=toggle_quick_terminal
keybind = shift+enter=text:\n


# Omarchy: follow its theme switcher (loaded last, so it overrides `theme`
# above). The leading `?` makes it optional, so macOS ignores it.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
# Omarchy-only overrides (omarchy group), e.g. a Linux-sized font.
config-file = ?omarchy.conf
