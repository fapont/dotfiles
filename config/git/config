# -> ~/.config/git/config (symlinked). Machine-local settings, and anything a
# tool writes with `git config --global` (e.g. `gh auth setup-git`), go to
# ~/.gitconfig instead: git reads it after this file, so it wins on conflicts.

[user]
	name = Fabrice Pont
	email = fabrice.pont@doctolib.com
	# per-machine key from `mise run setup-github-ssh`, registered for auth + signing
	signingkey = ~/.ssh/id_ed25519_github.pub

[gpg]
	format = ssh
[gpg "ssh"]
	# also written by setup-github-ssh, lets `git log --show-signature` verify locally
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true

[init]
	defaultBranch = main

# first `git push` of a new branch sets its upstream, no `-u origin <branch>` needed
[push]
	autoSetupRemote = true

# delta as the diff pager: https://dandavison.github.io/delta/configuration.html
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only

# equivalent of `git lfs install`, done declaratively here instead
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Identity per context: work email by default, personal email when the repo
# lives under ~/Perso, is this dotfiles checkout, or points at a fapont/* remote
# (so a personal repo cloned anywhere still gets the right email). To add
# another context (new employer, client...): a new file next to `perso` with its
# own [user] and one includeIf here.
[includeIf "gitdir:~/Perso/"]
	path = ~/.config/git/perso
[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.config/git/perso
[includeIf "hasconfig:remote.*.url:git@github.com:fapont/**"]
	path = ~/.config/git/perso
[includeIf "hasconfig:remote.*.url:https://github.com/fapont/**"]
	path = ~/.config/git/perso
