#!/usr/bin/env bash
#MISE description="Set up the ~/Obsidian vault with self-hosted LiveSync"
#MISE raw=true
set -euo pipefail
vault="$HOME/Obsidian"
plugin="$vault/.obsidian/plugins/obsidian-livesync"
if [[ $OSTYPE == darwin* ]]; then
  registry="$HOME/Library/Application Support/obsidian/obsidian.json"
  copy() { pbcopy; }
  launch() { open "$@"; }
  running() { pgrep -x Obsidian >/dev/null; }
  quit() { osascript -e 'quit app "Obsidian"' 2>/dev/null || true; }
else
  registry="${XDG_CONFIG_HOME:-$HOME/.config}/obsidian/obsidian.json"
  copy() { wl-copy; }
  launch() { xdg-open "$@" >/dev/null 2>&1; }
  # ponytail: Arch runs Obsidian under a shared electron binary, so match its asar path
  running() { pgrep -f 'obsidian/app\.asar' >/dev/null; }
  quit() { pkill -f 'obsidian/app\.asar' || true; }
fi

if [ -z "${FORCE:-}" ] && jq -e '.isConfigured' "$plugin/data.json" >/dev/null 2>&1; then
  echo "LiveSync already configured in $vault, nothing to do (FORCE=1 to re-apply)"
  exit 0
fi

setup=$(
  export LIVESYNC_COUCHDB_URI=https://livesync.example.invalid
  export LIVESYNC_COUCHDB_USER=$(fnox -P obsidian get LIVESYNC_COUCHDB_USER)
  export LIVESYNC_COUCHDB_DB=$(fnox -P obsidian get LIVESYNC_COUCHDB_DB)
  export LIVESYNC_COUCHDB_PASSWORD=$(fnox -P obsidian get LIVESYNC_COUCHDB_PASSWORD)
  export LIVESYNC_E2EE_PASSPHRASE=$(fnox -P obsidian --if-missing ignore get LIVESYNC_E2EE_PASSPHRASE 2>/dev/null || true)
  mise x deno@2 -- deno run -q --allow-env --allow-net --allow-read \
    "$MISE_CONFIG_ROOT/setup-obsidian.ts" | tail -2
)
passphrase=$(sed -n 1p <<<"$setup")
uri=$(sed -n 2p <<<"$setup")

mkdir -p "$plugin"
for f in main.js manifest.json styles.css; do
  [ -f "$plugin/$f" ] || curl -fsSL -o "$plugin/$f" "https://github.com/vrtmrz/obsidian-livesync/releases/latest/download/$f"
done
[ -f "$vault/.obsidian/community-plugins.json" ] || echo '["obsidian-livesync"]' > "$vault/.obsidian/community-plugins.json"

# Obsidian only opens vaults listed in its registry, and rewrites it on quit.
if ! { [ -f "$registry" ] && jq -e --arg p "$vault" '.vaults[]? | select(.path == $p)' "$registry" >/dev/null; }; then
  quit
  while running; do sleep 0.5; done
  mkdir -p "$(dirname "$registry")"
  [ -f "$registry" ] || echo '{}' > "$registry"
  tmp=$(mktemp)
  jq --arg id "$(openssl rand -hex 8)" --arg p "$vault" --argjson ts "$(date +%s)000" \
    '.vaults[$id] = {path: $p, ts: $ts, open: true}' "$registry" > "$tmp"
  mv "$tmp" "$registry"
fi

launch obsidian://
printf 'In Obsidian: "Trust author and enable plugins", then press Enter here... '
read -r _
printf '%s' "$uri" | copy
launch "$uri"
printf 'Setup URI opened and copied. No LiveSync dialog? Cmd/Ctrl+P > "Use the copied setup URI". Press Enter once it asks for the passphrase... '
read -r _
printf '%s' "$passphrase" | copy
printf 'Passphrase copied, paste it, pick "fetch from remote" (and "Fetch" for hidden files), then press Enter... '
read -r _
copy </dev/null
echo "Done. LiveSync will now pull the vault from the server."
