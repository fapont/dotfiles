#!/usr/bin/env bash
#MISE description="Create this machine's git SSH key and register it with GitHub (auth + commit signing)"
set -euo pipefail
if ! gh ssh-key list >/dev/null 2>&1; then
  gh auth refresh -h github.com -s admin:public_key,admin:ssh_signing_key
fi
if [ ! -f ~/.ssh/id_ed25519_github ]; then
  ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_github -N "" -C "fabrice.pont@doctolib.com"
fi
pubkey=$(awk '{print $1, $2}' ~/.ssh/id_ed25519_github.pub)
keys=$(gh ssh-key list)
for type in authentication signing; do
  if ! grep -F "$pubkey" <<<"$keys" | grep -qw "$type"; then
    gh ssh-key add ~/.ssh/id_ed25519_github.pub --type "$type" --title "$(scutil --get ComputerName)" \
      || { gh auth refresh -h github.com -s admin:public_key,admin:ssh_signing_key \
           && gh ssh-key add ~/.ssh/id_ed25519_github.pub --type "$type" --title "$(scutil --get ComputerName)"; }
  fi
done
# Every identity in config/git/{config,perso} signs with this key.
mkdir -p ~/.config/git
emails=$(git config --file ~/.dotfiles/config/git/config user.email),$(git config --file ~/.dotfiles/config/git/perso user.email)
echo "$emails namespaces=\"git\" $pubkey" > ~/.config/git/allowed_signers
gh config set git_protocol ssh
echo "Git SSH ready: ~/.ssh/id_ed25519_github (auth + signing)"
